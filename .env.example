# PostgreSQL / Docker
POSTGRES_DB=sescinc
POSTGRES_USER=sescinc
POSTGRES_PASSWORD=sescinc_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sescinc:sescinc_password@localhost:5432/sescinc

# API
PORT=3333
API_PREFIX=api
FRONTEND_ORIGIN=http://localhost:5173
STORAGE_PATH=./storage

# Front-end
VITE_API_BASE_URL=http://localhost:3333/api

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@sescinc.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# External services
AUTENTIQUE_TOKEN=
