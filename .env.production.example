# Site
# Use :80 for testing by public IP. Use your domain later, for example: sistema.example.com
APP_SITE_ADDRESS=:80

# PostgreSQL
POSTGRES_DB=sescinc
POSTGRES_USER=sescinc
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://sescinc:change_this_password@postgres:5432/sescinc

# API
NODE_ENV=production
PORT=3333
API_PREFIX=api
FRONTEND_ORIGIN=http://YOUR_PUBLIC_IP
PUBLIC_API_URL=http://YOUR_PUBLIC_IP/api
STORAGE_PATH=/app/backend/storage

# Front-end build
VITE_API_BASE_URL=/api

# External services
AUTENTIQUE_TOKEN=
# Vazio = producao. 'sandbox' = documentos de teste (gratis).
AUTENTIQUE_MODO=
# Segredo que o painel do Autentique mostra ao cadastrar o webhook (https://<dominio>/api/autentique/webhook)
AUTENTIQUE_WEBHOOK_SECRET=

# Segredo para assinar as sessoes de login (minimo 32 caracteres; o deploy gera um se faltar)
JWT_SECRET=

# Google Drive (só leitura) - documentos da tela de Certificações.
# Pasta principal compartilhada como Leitor com a conta de serviço; a chave .json NUNCA no repositório.
GOOGLE_DRIVE_PASTA_RAIZ=
# Use um dos dois: caminho do .json no servidor, ou o conteúdo do .json (puro ou base64).
GOOGLE_DRIVE_CREDENCIAIS_ARQUIVO=
GOOGLE_DRIVE_CREDENCIAIS_JSON=
