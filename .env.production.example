# Site
# Use :80 for testing by public IP. Use your domain later, for example: sistema.example.com
APP_SITE_ADDRESS=:80

# PostgreSQL
POSTGRES_DB=sescinc
POSTGRES_USER=sescinc
POSTGRES_PASSWORD=change_this_password
DATABASE_URL=postgresql://sescinc:change_this_password@postgres:5432/sescinc

# API
NODE_ENV=production
PORT=3333
API_PREFIX=api
FRONTEND_ORIGIN=http://YOUR_PUBLIC_IP
PUBLIC_API_URL=http://YOUR_PUBLIC_IP/api
STORAGE_PATH=/app/backend/storage

# Front-end build
VITE_API_BASE_URL=/api

# External services
AUTENTIQUE_TOKEN=

