{
  "name": "sescinc-manager-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "pnpm --filter sescinc-manager dev",
    "dev:backend": "pnpm --filter @sescinc/backend start:dev",
    "build": "pnpm --filter @sescinc/backend build && pnpm --filter sescinc-manager build",
    "typecheck": "pnpm --filter sescinc-manager typecheck && pnpm --filter @sescinc/backend typecheck",
    "lint": "pnpm --filter sescinc-manager lint && pnpm --filter @sescinc/backend lint",
    "db:up": "docker compose up -d postgres pgadmin",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @sescinc/backend db:migrate"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js",
      "puppeteer"
    ]
  }
}
